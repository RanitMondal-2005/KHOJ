# KHOJ .gitignore

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.cache/

# ── Virtual environments ──
venv/
.venv/
env/
ENV/
djenv/
khojenv/
virtualenv/

# ── Secrets & environment variables ──
.env
.env.*
!.env.example
*.pem
*.key
secrets.json

# ── Django ──
*.log
logs/
local_settings.py
db.sqlite3
db.sqlite3-journal
*.sqlite3
staticfiles/
static_root/
media/

# ── Packaging / build ──
dist/
build/
*.egg-info/
*.egg
wheels/
pip-log.txt
pip-wheel-metadata/

# ── Deployment (PythonAnywhere / servers) ──
*.pid
*.sock
nohup.out
*.bak
*.tmp
*.orig
*.rej
.pythonanywhere/
*.wsgi.bak

# ── Node (for any frontend tooling, if any added later) ──
node_modules/

# ── IDEs / editors ──
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ── macOS ──
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# ── Windows ──
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ── Linux ──
.directory
.Trash-*
.nfs*
